PORT=3333
DATABASE_URL=postgres://postgres:agrosys@localhost:5433/atualizador_dev
PACKAGES_PATH=../packages
DATABASE_BACKUPS_PATH=./data/bancos
PACKAGE_SIGNING_KEY_PATH=./data/package-signing-key.pem
DOWNLOAD_BASE_URL=/downloads
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
INSTALLATION_KEY=chave-inicial-das-instalacoes
TRUST_PROXY=1
TERMINAL_KEY_ENFORCEMENT=confirmed
HEALTH_MIN_FREE_MB=1024
LOG_FORMAT=json

# Hub de Integracao (servico separado): URL da API e chave de servico (HUB_SERVICE_KEY do Hub)
HUB_API_URL=http://localhost:4000
HUB_SERVICE_KEY=
# Endereco publico da API do Hub mostrado na documentacao (padrao: HUB_API_URL)
#HUB_PUBLIC_URL=

# Consulta publica de CNPJ (padrao: BrasilAPI)
#CNPJ_LOOKUP_URL=https://brasilapi.com.br/api/cnpj/v1

# ---- Login pelo Zitadel (central de identidade Agrosys) ----
# local   = so o login atual (padrao; nada muda)
# ambos   = login atual + botao "Entrar com Agrosys" (modo de migracao)
# zitadel = so o Zitadel (login local desligado)
AUTH_MODO=local
# Com ambos/zitadel:
#ZITADEL_URL=http://localhost:8080
# Registro automatico: com estes dois, a API se registra sozinha na central ao subir (guarda as credenciais ao lado da chave de assinatura, em zitadel-app.json).
# No Docker, PUBLIC_URL ja existe e serve no lugar de PAINEL_PUBLIC_URL.
#ZITADEL_REGISTRO_TOKEN=
#PAINEL_PUBLIC_URL=http://localhost:3000
#ZITADEL_CREDENCIAIS=C:/Projetos/Keycloak/.credenciais/credenciais.json   # ou os 5 valores abaixo
#ZITADEL_PROJETO_ID=
#ZITADEL_CLIENT_ID=
#ZITADEL_CLIENT_SECRET=
#ZITADEL_SERVICO_USUARIO=svc-atualizador
#ZITADEL_SERVICO_SEGREDO=
#CENTRAL_URL=http://localhost:3000
# opcional: sem ele vale o endereco em que o navegador abriu o painel (precisa estar cadastrado como redirect no Zitadel).
# Atencao: a porta 3000 do host e da central; se o painel Next estiver em outra, nao use 3000 aqui.
#PAINEL_PUBLIC_URL=http://localhost:3000
