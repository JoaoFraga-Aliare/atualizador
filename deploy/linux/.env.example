# Copie para .env (mesma pasta) e preencha. Gerar segredos: openssl rand -base64 32
PUBLIC_URL=http://IP-OU-DOMINIO:3405
POSTGRES_PASSWORD=
ADMIN_USER=admin
ADMIN_PASSWORD=
JWT_SECRET=
INSTALLATION_KEY=
HUB_JWT_SECRET=
# minimo 24 caracteres; usada pelo Atualizador para chamar o Hub
HUB_SERVICE_KEY=
# 32 bytes base64. FACA BACKUP FORA DO SERVIDOR: sem ela os certificados do Hub nao abrem
HUB_CERT_MASTER_KEY=
