# API
HUB_DATABASE_URL=postgres://postgres:agrosys@localhost:5432/hub_dev
HUB_JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
HUB_API_PORT=4000
# Web
HUB_API_URL=http://localhost:4000
# Chave (min. 24 caracteres) para o painel do Atualizador chamar a API como administrador
HUB_SERVICE_KEY=
# Webhooks: "sim" libera URLs http e destinos em rede interna (so para desenvolvimento)
#HUB_WEBHOOK_REDE_INTERNA=sim
# Chave-mestra dos certificados digitais (32 bytes em base64 ou hex). FORA do banco; faca backup: sem ela os certificados guardados nao abrem.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#HUB_CERT_MASTER_KEY=
# Alternativa: caminho de um arquivo (protegido no servidor) com a chave
#HUB_CERT_KEY_FILE=
# Atras de proxy reverso (Nginx): numero de proxies. Sem isso o limite de taxa ve so o IP do proxy e todos os clientes
# dividem a mesma cota. NAO defina se o Hub estiver exposto direto. Veja docs/hub/11-operacao-seguranca.md
#HUB_TRUST_PROXY=1
# Limites de taxa (padroes entre parenteses)
#HUB_RATE_LOGIN_MAX=10          # falhas de login por IP+e-mail na janela
#HUB_RATE_LOGIN_IP_MAX=40       # falhas de login por IP
#HUB_RATE_LOGIN_JANELA_S=300    # janela do login (s)
#HUB_RATE_401_MAX=100           # respostas 401 por IP por minuto
#HUB_RATE_CRED_MAX=1200         # requisicoes por credencial por minuto
# Alertas de monitoramento: intervalo da avaliacao em segundos (60; 0 desliga) e endpoint que recebe um POST JSON por alerta novo
#HUB_ALERTAS_SEGUNDOS=60
#HUB_ALERTA_URL=https://hooks.slack.com/services/...
