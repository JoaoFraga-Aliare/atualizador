# Copie para .env (nunca commitar o .env). Valores abaixo são APENAS de desenvolvimento.
NODE_ENV=development
PORT=3333
HOST=127.0.0.1

# Dono do schema (roda migrations)
DATABASE_URL_MIGRATION=postgres://hub_owner:hub_owner_dev@localhost:5432/hub
# Papel da aplicação: sem BYPASSRLS, sujeito às policies de RLS
DATABASE_URL=postgres://hub_app:hub_app_dev@localhost:5432/hub

# Chave AES-256 (32 bytes em base64) para segredos em repouso.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SEGREDOS_CHAVE=

# Origem permitida do painel web (CORS)
WEB_ORIGEM=http://localhost:3000

# docker-compose
POSTGRES_PASSWORD=hub_owner_dev
HUB_APP_PASSWORD=hub_app_dev
