{
  "name": "hub",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "gerar": "npm run gerar -w @hub/contracts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "dev:api": "npm run dev -w @hub/api",
    "dev:web": "npm run dev -w @hub/web",
    "migrate": "npm run migrate -w @hub/api",
    "postman": "tsx scripts/gerar-postman.ts",
    "diagnostico": "tsx --env-file-if-exists=.env scripts/diagnostico.mts",
    "consumo": "tsx --env-file-if-exists=.env scripts/consumo.mts"
  },
  "engines": {
    "node": ">=20"
  }
}
